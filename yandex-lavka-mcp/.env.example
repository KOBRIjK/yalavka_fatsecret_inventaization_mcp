# Optional: copy this file to .env to override Compose defaults.
# Path to an existing, writable config.json. Forward slashes work on Windows.
YANDEX_LAVKA_MCP_CONFIG_FILE=./config.json
YANDEX_LAVKA_MCP_PORT=8000

# Local-only HTTP: Compose publishes the port on 127.0.0.1.
# For a remote deployment, configure OAuth and set this to 0.
YANDEX_LAVKA_MCP_ALLOW_INSECURE=1
YANDEX_LAVKA_MCP_SPRAVKA=
YANDEX_LAVKA_MCP_OAUTH_ISSUER=
YANDEX_LAVKA_MCP_SERVER_URL=
YANDEX_LAVKA_MCP_OAUTH_AUDIENCE=
YANDEX_LAVKA_MCP_OAUTH_SCOPES=
YANDEX_LAVKA_MCP_OAUTH_SUBJECTS=
YANDEX_LAVKA_MCP_OAUTH_JWKS_URL=
